<?xml version="1.0" encoding="utf-8"?>
<com.example.c001apk.compose.view.SmoothInputLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    app:silEmojiPanel="@+id/emojiLayout"
    app:silInputView="@+id/editText">

    <View
        android:id="@+id/out"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/inputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/reply_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <FrameLayout
                android:id="@+id/replyDragArea"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:contentDescription="下拉关闭"
                android:visibility="gone">
                <View android:id="@+id/replyDragHandle"
                    android:layout_width="40dp" android:layout_height="4dp"
                    android:layout_gravity="center" />
            </FrameLayout>
            <LinearLayout android:id="@+id/replyHeaderRow"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="52dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/replyCancel"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="12dp" android:contentDescription="关闭"
                    android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
                <TextView android:id="@+id/title"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:padding="16dp" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" />
                <ImageView android:id="@+id/replyAvatar"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:visibility="gone" />
                <TextView android:id="@+id/replyTargetName"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:visibility="gone" />
                <TextView android:id="@+id/publish"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:padding="16dp" android:text="发布" android:textSize="16sp"
                    android:textColor="@android:color/darker_gray" android:foreground="@drawable/selector_reply" />
                <ImageView android:id="@+id/replySend"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="12dp" android:contentDescription="发送"
                    android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            app:counterEnabled="true"
            app:counterMaxLength="500"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/reply_header">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="start"
                android:lineSpacingMultiplier="1.2"
                android:maxLength="500"
                android:maxLines="8"
                android:minLines="4"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:button="@null"
            android:drawableStart="?android:attr/listChoiceIndicatorMultiple"
            android:text="回复并转发"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textInputLayout" />

        <HorizontalScrollView
            android:id="@+id/imageScrollLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/checkBox">

            <LinearLayout
                android:id="@+id/imageLayout"
                android:layout_width="wrap_content"
                android:layout_height="65dp"
                android:orientation="horizontal"
                android:paddingStart="11dp"
                android:paddingEnd="16dp"
                android:visibility="gone" />

        </HorizontalScrollView>

        <View
            android:id="@+id/line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageScrollLayout" />

        <LinearLayout
            android:id="@+id/replyToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line">

            <ImageView
                android:id="@+id/emojiBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/actionBarItemBackground"
                android:padding="8dp"
                android:stateListAnimator="@animator/reply_action_button_scale"
                android:src="@drawable/outline_emoji_emotions_24" />

            <ImageView
                android:id="@+id/imageBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/actionBarItemBackground"
                android:padding="8dp"
                android:stateListAnimator="@animator/reply_action_button_scale"
                android:src="@drawable/outline_image_24" />

            <ImageView
                android:id="@+id/otherImageBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/actionBarItemBackground"
                android:padding="8dp"
                android:stateListAnimator="@animator/reply_action_button_scale"
                android:src="@drawable/outline_note_alt_24" />

            <ImageView
                android:id="@+id/atBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/actionBarItemBackground"
                android:padding="8dp"
                android:stateListAnimator="@animator/reply_action_button_scale"
                android:src="@drawable/outline_alternate_email_24" />

            <ImageView
                android:id="@+id/tagBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/actionBarItemBackground"
                android:padding="8dp"
                android:stateListAnimator="@animator/reply_action_button_scale"
                android:src="@drawable/outline_tag_24" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/emojiLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/emojiPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/line2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/line2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorSurfaceVariant"
            app:layout_constraintBottom_toTopOf="@id/indicator"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/indicator"
            android:layout_width="match_parent"
            android:layout_height="41dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.example.c001apk.compose.view.SmoothInputLayout>
